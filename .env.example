# 产品方案展示平台 · 环境变量模板（复制为 .env 并按需修改）
# 用法：cp .env.example .env   （.env 已被 .gitignore 忽略，勿提交真实密钥）
# docker-compose up 时自动读取本目录的 .env；本地 dev 用 export / 上述写法注入。

# ── 安全密钥（生产务必改为强随机串） ─────────────────────────────
PLATFORM_SECRET=dev-secret-change-me

# ── 邮件（登录验证码；网易 163 免费邮箱示例） ────────────────────
# 163 需先在网页邮箱「设置 → POP3/SMTP/IMAP」开启 SMTP 服务并生成【授权码】，
# SMTP_PASS 填授权码，不是登录密码。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 465/994 用隐式 SSL 需设为 1；587（STARTTLS）设 0 或留空
SMTP_USE_SSL=1
SMTP_USER=your@163.com
# 你的 16 位授权码（非登录密码）
SMTP_PASS=your-163-authcode
# 163 要求发件地址 = 登录账号邮箱
SMTP_FROM=your@163.com
# E2E/开发假邮件模式：设为 1 时验证码写入 /tmp/ppp-fake-mailbox/ 不真发。
# 生产/真发邮件必须【为空】或删除本行。make dev 默认带 SMTP_FAKE=1，需覆盖。
SMTP_FAKE=

# ── 可选：服务端口与数据目录 ─────────────────────────────────────
# PORT=8081
# DATA_DIR=/data           # docker-compose 固定 /data，删除时勿覆盖
# DEMO_REPO_DIR=           # 演示项目 fixture 路径（默认 tests/fixtures）
