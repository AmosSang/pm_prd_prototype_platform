# 产品方案展示平台 · 环境变量模板（复制为 .env 并按需修改）
# 用法：cp .env.example .env   （.env 已被 .gitignore 忽略，勿提交真实密钥）
# docker-compose up 时自动读取本目录的 .env；本地 dev 用 export / 上述写法注入。

# ── 安全密钥（生产务必改为强随机串） ─────────────────────────────
PLATFORM_SECRET=dev-secret-change-me

# ── 超级管理员（T2.1 用户管理增强）────────────────────────────
# 初始启动时写入 users 表为超管（name=admin，is_admin=True），可直接用该邮箱登录。
# 幂等：已存在则确保 is_admin=True；留空 = 不种子超管。
# 超管登录后首页右上角出现「用户管理」入口，可建用户/改名/停用启用账号。
ADMIN_EMAIL=admin@corp.com

# ── 邮件（登录验证码；网易 163 免费邮箱示例） ────────────────────
# 163 需先在网页邮箱「设置 → POP3/SMTP/IMAP」开启 SMTP 服务并生成【授权码】，
# SMTP_PASS 填授权码，不是登录密码。
SMTP_HOST=smtp.163.com
SMTP_PORT=465
# 465/994 用隐式 SSL 需设为 1；587（STARTTLS）设 0 或留空
SMTP_USE_SSL=1
SMTP_USER=your@163.com
# 你的 16 位授权码（非登录密码）
SMTP_PASS=your-163-authcode
# 163 要求发件地址 = 登录账号邮箱
SMTP_FROM=your@163.com
# E2E/开发假邮件模式：设为 1 时验证码写入 /tmp/ppp-fake-mailbox/ 不真发。
# 生产/真发邮件必须【为空】或删除本行。make dev 默认带 SMTP_FAKE=1，需覆盖。
SMTP_FAKE=

# ── 可选：服务端口与数据目录 ─────────────────────────────────────
# PORT=8081
# DATA_DIR=/data           # docker-compose 固定 /data，删除时勿覆盖
# DEMO_REPO_DIR=           # 演示项目 fixture 路径（默认 tests/fixtures）

# ── MCP Server（T12.3/T12.4/T12.6；compose 的 mcp 服务已内置右侧默认值） ──
# MCP 监听（默认 0.0.0.0:8082；生产经 Nginx /mcp 反代暴露，HTTPS 为硬前置）
# MCP_HOST=0.0.0.0
# MCP_PORT=8082
# HTTP 请求体上限：base64 大参数上传用，SDK 默认 4MiB 不够（5MB zip 即 413），
# 默认 160MiB 覆盖「100MB zip → ~134MB base64」全量程；详见 docs/poc-report-mcp-upload.md
# MCP_MAX_REQUEST_BODY_BYTES=167772160
# 回环 Flask 地址：compose 内为服务名 http://server:8081；本机手起默认 127.0.0.1:8081
# PPP_API_BASE=http://127.0.0.1:8081
# download_prototype 生成下载直链用的平台基址：留空则按 MCP 请求的 scheme+Host 推导
# （Nginx 同域反代时即平台域名）；本机 dev 或独立域名时显式填写
# PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:8081
